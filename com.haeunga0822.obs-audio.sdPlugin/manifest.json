{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"SDKVersion": 2,
	"UUID": "com.haeunga0822.obs-audio",
	"Name": "Web-Socket Audio Controller",
	"Version": "1.0.0.0",
	"Author": "Kimtan2",
	"Icon": "imgs/plugin",
	"Category": "Web-Socket Audio Controller",
	"CategoryIcon": "imgs/category",
	"Description": "OBS audio mixer meters, volume, mute, push to talk, monitoring and balance over obs-websocket.",
	"CodePath": "bin/plugin.js",
	"Nodejs": {
		"Version": "20"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Software": {
		"MinimumVersion": "7.3"
	},
	"Actions": [
		{
			"Name": "VU Dial",
			"UUID": "com.haeunga0822.obs-audio.vu-dial",
			"Icon": "imgs/dial",
			"Tooltip": "OBS source meter and volume",
			"Controllers": [
				"Encoder"
			],
			"PropertyInspectorPath": "ui/obs.html",
			"Encoder": {
				"layout": "layouts/strip.json",
				"TriggerDescription": {
					"Rotate": "Volume +/- 1 dB",
					"Push": "Mute",
					"Touch": "Mute"
				}
			},
			"States": [
				{
					"Image": "imgs/dial"
				}
			]
		},
		{
			"Name": "Fader(2-Button)",
			"UUID": "com.haeunga0822.obs-audio.button-fader",
			"Icon": "imgs/fader",
			"Tooltip": "Two keys make one fader with a meter",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/obs.html",
			"States": [
				{
					"Image": "imgs/fader"
				}
			]
		},
		{
			"Name": "Mute",
			"UUID": "com.haeunga0822.obs-audio.mute",
			"Icon": "imgs/channel",
			"Tooltip": "Mute toggle with a meter",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/obs.html",
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/channel"
				},
				{
					"Image": "imgs/channel"
				}
			]
		},
		{
			"Name": "Volume",
			"UUID": "com.haeunga0822.obs-audio.volume",
			"Icon": "imgs/fader",
			"Tooltip": "Set or step the volume",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/obs.html",
			"States": [
				{
					"Image": "imgs/fader"
				}
			]
		},
		{
			"Name": "Push to talk / Push to mute",
			"UUID": "com.haeunga0822.obs-audio.ptt",
			"Icon": "imgs/channel",
			"Tooltip": "Unmute (or mute) while held",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/obs.html",
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/channel"
				},
				{
					"Image": "imgs/channel"
				}
			]
		},
		{
			"Name": "Talkback",
			"UUID": "com.haeunga0822.obs-audio.talkback",
			"Icon": "imgs/channel",
			"Tooltip": "Lower or mute the other sources while held (or until pressed again)",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/obs.html",
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/channel"
				},
				{
					"Image": "imgs/channel"
				}
			]
		},
		{
			"Name": "Audio monitoring",
			"UUID": "com.haeunga0822.obs-audio.monitor",
			"Icon": "imgs/channel",
			"Tooltip": "Set or cycle audio monitoring",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/obs.html",
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/channel"
				},
				{
					"Image": "imgs/channel"
				}
			]
		},
		{
			"Name": "Balance Dial",
			"UUID": "com.haeunga0822.obs-audio.balance-dial",
			"Icon": "imgs/dial",
			"Tooltip": "Left / right balance",
			"Controllers": [
				"Encoder"
			],
			"PropertyInspectorPath": "ui/obs.html",
			"Encoder": {
				"layout": "layouts/strip.json",
				"TriggerDescription": {
					"Rotate": "Balance +/- 1%",
					"Push": "Centre"
				}
			},
			"States": [
				{
					"Image": "imgs/dial"
				}
			]
		},
		{
			"Name": "Balance",
			"UUID": "com.haeunga0822.obs-audio.balance",
			"Icon": "imgs/global",
			"Tooltip": "Set or step the balance",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/obs.html",
			"States": [
				{
					"Image": "imgs/global"
				}
			]
		}
	]
}
