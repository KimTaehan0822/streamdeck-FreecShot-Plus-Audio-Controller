{
	"name": "streamdeck-obs-audio",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"bundle": "node scripts/make-freecshot.mjs && rollup -c rollup.config.mjs",
		"test": "npm run bundle && npm run build && node --test test/*.test.mjs",
		"watch": "rollup -c rollup.config.mjs -w --watch.onEnd=\"streamdeck restart com.haeunga0822.obs-audio\"",
		"pack": "npm run bundle && streamdeck pack -f com.haeunga0822.obs-audio.sdPlugin && streamdeck pack -f com.haeunga0822.freecshot-audio.sdPlugin"
	},
	"dependencies": {
		"@elgato/streamdeck": "3.0.4",
		"obs-websocket-js": "5.0.8"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.4",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/node": "^26.6.6",
		"rollup": "^4.66.0",
		"tslib": "^2.8.1",
		"typescript": "~6.0.3"
	}
}
